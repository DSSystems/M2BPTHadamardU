      RowBox[{"\[Delta]Mode", "[", "dt_", "]"}], "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"U", " ", 
          RowBox[{"(", 
           RowBox[{
            FractionBox[
             RowBox[{"\[Delta]\[Tau]", " ", 
              SuperscriptBox[
               RowBox[{"Cos", "[", 
                FractionBox["\[Tau]", "2"], "]"}], 
               RowBox[{"2", " ", 
                RowBox[{"Abs", "[", "s", "]"}]}]], " ", 
              RowBox[{"JacobiP", "[", 
               RowBox[{
                RowBox[{"l", "-", 
                 RowBox[{"Abs", "[", "s", "]"}]}], ",", "0", ",", 
                RowBox[{"Abs", "[", 
                 RowBox[{"2", "s"}], "]"}], ",", 
                RowBox[{"Cos", "[", "\[Tau]", "]"}]}], "]"}], " ", 
              RowBox[{"(", 
               RowBox[{
                FractionBox[
                 RowBox[{"Cos", "[", "\[Tau]", "]"}], "\[Tau]"], "-", 
                FractionBox[
                 RowBox[{"Sin", "[", "\[Tau]", "]"}], 
                 SuperscriptBox["\[Tau]", "2"]]}], ")"}]}], 
             RowBox[{"4", " ", 
              SqrtBox[
               RowBox[{"Sinc", "[", "\[Tau]", "]"}]]}]], "-", 
            RowBox[{
             FractionBox["1", "2"], " ", "\[Delta]\[Tau]", " ", 
             RowBox[{"Abs", "[", "s", "]"}], " ", 
             SuperscriptBox[
              RowBox[{"Cos", "[", 
               FractionBox["\[Tau]", "2"], "]"}], 
              RowBox[{
               RowBox[{"-", "1"}], "+", 
               RowBox[{"Abs", "[", 
                RowBox[{"2", "s"}], "]"}]}]], " ", 
             RowBox[{"P", "[", 
              RowBox[{
               RowBox[{"l", "-", 
                RowBox[{"Abs", "[", "s", "]"}]}], ",", "0", ",", 
               RowBox[{"Abs", "[", 
                RowBox[{"2", "s"}], "]"}], ",", 
               RowBox[{"Cos", "[", "\[Tau]", "]"}]}], "]"}], " ", 
             RowBox[{"Sin", "[", 
              FractionBox["\[Tau]", "2"], "]"}], " ", 
             SqrtBox[
              RowBox[{"Sinc", "[", "\[Tau]", "]"}]]}], "-", 
            RowBox[{
             FractionBox["1", "4"], " ", "\[Delta]\[Tau]", " ", 
             RowBox[{"(", 
              RowBox[{"1", "+", "l", "+", 
               RowBox[{"Abs", "[", "s", "]"}]}], ")"}], " ", 
             SuperscriptBox[
              RowBox[{"Cos", "[", 
               FractionBox["\[Tau]", "2"], "]"}], 
              RowBox[{"Abs", "[", 
               RowBox[{"2", "s"}], "]"}]], " ", 
             RowBox[{"P", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "1"}], "+", "l", "-", 
                RowBox[{"Abs", "[", "s", "]"}]}], ",", "1", ",", 
               RowBox[{"1", "+", 
                RowBox[{"Abs", "[", 
                 RowBox[{"2", "s"}], "]"}]}], ",", 
               RowBox[{"Cos", "[", "\[Tau]", "]"}]}], "]"}], " ", 
             RowBox[{"Sin", "[", "\[Tau]", "]"}], " ", 
             SqrtBox[
              RowBox[{"Sinc", "[", "\[Tau]", "]"}]]}]}], ")"}]}], "+", 
         RowBox[{
          FractionBox["1", "2"], " ", "\[Delta]U", " ", 
          SuperscriptBox[
           RowBox[{"Cos", "[", 
            FractionBox["\[Tau]", "2"], "]"}], 
           RowBox[{"Abs", "[", 
            RowBox[{"2", "s"}], "]"}]], " ", 
          RowBox[{"P", "[", 
           RowBox[{
            RowBox[{"l", "-", 
             RowBox[{"Abs", "[", "s", "]"}]}], ",", "0", ",", 
            RowBox[{"Abs", "[", 
             RowBox[{"2", "s"}], "]"}], ",", 
            RowBox[{"Cos", "[", "\[Tau]", "]"}]}], "]"}], " ", 
          SqrtBox[
           RowBox[{"Sinc", "[", "\[Tau]", "]"}]]}]}], ")"}], 
       RowBox[{"\[Theta]", "[", "\[Tau]", "]"}], 
       RowBox[{"\[Theta]", "[", 
        RowBox[{"\[Pi]", "-", "\[Tau]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"mode", "[", "dt_", "]"}], "=", 
      RowBox[{
       FractionBox["1", "2"], " ", "U", 
       SqrtBox[
        RowBox[{"Sinc", "[", "\[Tau]", "]"}]], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"Cos", "[", 
          FractionBox["\[Tau]", "2"], "]"}], ")"}], 
        RowBox[{"Abs", "[", 
         RowBox[{"2", "s"}], "]"}]], 
       RowBox[{"P", "[", 
        RowBox[{
         RowBox[{"l", "-", 
          RowBox[{"Abs", "[", "s", "]"}]}], ",", "0", ",", 
         RowBox[{"Abs", "[", 
          RowBox[{"2", "s"}], "]"}], ",", 
         RowBox[{"Cos", "[", "\[Tau]", "]"}]}], "]"}], 
       RowBox[{"\[Theta]", "[", "\[Tau]", "]"}], 
       RowBox[{"\[Theta]", "[", 
        RowBox[{"\[Pi]", "-", "\[Tau]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"full\[Delta]Mode", "[", 
       RowBox[{"\[Delta]M_", ",", "dt_"}], "]"}], "=", 
      RowBox[{
       FractionBox[
        RowBox[{"\[Delta]Mode", "[", "dt", "]"}], 
        SuperscriptBox["rValue", "2"]], "-", 
       FractionBox[
        RowBox[{"mode", "[", "dt", "]"}], 
        SuperscriptBox["rValue", "3"]]}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"Grid", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
