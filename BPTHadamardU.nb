Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Sigma]Func", ",", 
     RowBox[{"dr", "=", "0"}], ",", "r", ",", 
     RowBox[{"M", "=", "1"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"r", "=", 
     RowBox[{"6", "M"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"\[Sigma]Func", "=", 
     RowBox[{
      RowBox[{"\[Sigma]", "[", 
       RowBox[{"r", ",", "dr", ",", "dt"}], "]"}], "/.", 
      RowBox[{"{", 
       RowBox[{"\[Epsilon]", "->", "1"}], "}"}]}]}], ";", 
