Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Sigma]", "[", 
    RowBox[{"r_", ",", "dr_", ",", "dt_"}], "]"}], "=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Sigma]Sum", ",", 
       RowBox[{"nmax", "=", "20"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Get", "[", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"NotebookDirectory", "[", "]"}], ",", 
          RowBox[{"\"\<sigma_2d_t_r_nmax\>\"", "<>", 
           RowBox[{"ToString", "@", "nmax"}], "<>", "\"\<.m\>\""}]}], "}"}], 
        "]"}], "]"}], ";", "\[IndentingNewLine]", "\[Sigma]Sum"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.989251217367148*^9, 3.989251240757756*^9}, {
  3.989251333732709*^9, 3.98925139762593*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"9e2bf1e6-690d-4382-91a1-386ea3838fc9"],

