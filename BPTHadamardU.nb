          RowBox[{
           RowBox[{"full\[Delta]Mode", "[", 
            RowBox[{"\[Delta]Mode", ",", "dt"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"dt", ",", "0", ",", 
             RowBox[{"10", "M"}]}], "}"}], ",", 
           RowBox[{"Frame", "->", "True"}], ",", 
           RowBox[{"ImageSize", "->", "Medium"}], ",", 
           RowBox[{"FrameLabel", "->", 
            RowBox[{"{", 
             RowBox[{
             "\"\<\[CapitalDelta]t/M\>\"", ",", 
              "\"\<\!\(\*FractionBox[\(1\), \(4  \[Pi]\)]\)\!\(\*FractionBox[\
\(\[PartialD]\), \(\[PartialD]r\)]\)(\!\(\*FractionBox[\(1\), \(r\\\ \
r'\)]\)\!\(\*SubscriptBox[\(\[InvisiblePrefixScriptBase]\), \
\(s\)]\)\!\(\*SubsuperscriptBox[\(G\), \(l\), \(d\)]\)(r,r'))\>\""}], 
