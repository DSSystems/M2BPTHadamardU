       "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"order", ",", "1", ",", "sUNMax"}], "}"}]}], 
    "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", ",", 
