Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "@", "sU"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    SubscriptBox["sU", "s_"], "[", 
    RowBox[{"r_", ",", "dr_", ",", "dt_", ",", "M_"}], "]"}], "=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"U0nmax", ",", "U"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"U0nmax", "=", "20"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Get", "[", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"NotebookDirectory", "[", "]"}], ",", 
          RowBox[{"\"\<sU_2d_t_r_nmax\>\"", "<>", 
           RowBox[{"ToString", "@", "U0nmax"}], "<>", "\"\<.m\>\""}]}], "}"}],
         "]"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"U", "=", "0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"i", "+", "k"}], ">=", " ", "0"}], " ", "&&", " ", 
           RowBox[{
            RowBox[{"i", "+", "k"}], "<=", "U0nmax"}]}], ",", 
          RowBox[{"U", "=", 
           RowBox[{"U", "+", 
            RowBox[{
             RowBox[{
              RowBox[{"U0coef", "[", 
               RowBox[{"i", ",", "k"}], "]"}], "[", "r", "]"}], 
             RowBox[{"\[Epsilon]", "^", 
              RowBox[{"(", 
               RowBox[{"i", "+", "k"}], " ", ")"}]}], " ", 
             SuperscriptBox["dt", "i"], " ", 
             SuperscriptBox["dr", "k"]}]}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", "U0nmax"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "0", ",", "U0nmax"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"U", "/.", 
       RowBox[{"{", 
        RowBox[{"\[Epsilon]", "->", "1"}], "}"}]}]}]}], "\[IndentingNewLine]",
     "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.988991207378644*^9, 3.988991210045183*^9}, {
  3.988991682842963*^9, 3.988991699478023*^9}, {3.988991736146596*^9, 
  3.9889917437209263`*^9}, {3.9889917936886663`*^9, 3.988991896297719*^9}},
