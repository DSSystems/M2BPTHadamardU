Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Sigma]", "[", 
    RowBox[{"r_", ",", "dr_", ",", "dt_"}], "]"}], "=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Sigma]Sum", ",", 
       RowBox[{"nmax", "=", "20"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Get", "[", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"NotebookDirectory", "[", "]"}], ",", 
          RowBox[{"\"\<sigma_2d_t_r_nmax\>\"", "<>", 
           RowBox[{"ToString", "@", "nmax"}], "<>", "\"\<.m\>\""}]}], "}"}], 
        "]"}], "]"}], ";", "\[IndentingNewLine]", "\[Sigma]Sum"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
