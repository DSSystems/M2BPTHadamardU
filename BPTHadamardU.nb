            RowBox[{"dt", ",", "0", ",", 
             RowBox[{"10", "M"}]}], "}"}], ",", 
           RowBox[{"Frame", "->", "True"}], ",", 
           RowBox[{"ImageSize", "->", "Medium"}], ",", 
           RowBox[{"FrameLabel", "->", 
            RowBox[{"{", 
             RowBox[{
             "\"\<\[CapitalDelta]t/M\>\"", ",", 
              "\"\<\!\(\*FractionBox[\(1\), \(4  \[Pi]\)]\)\!\(\*FractionBox[\
\(\[PartialD]\), \(\[PartialD]r\)]\)\!\(\*SubscriptBox[\(\
\[InvisiblePrefixScriptBase]\), \(s\)]\)\!\(\*SubsuperscriptBox[\(G\), \(l\), \
\(d\)]\)(r,r')\>\""}], "}"}]}]}], "]"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
