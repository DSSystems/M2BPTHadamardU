Cell[BoxData[{
 RowBox[{"Clear", "@", "\[Sigma]Coef\[Gamma]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"\[Sigma]Coef\[Gamma]", "[", 
      RowBox[{"0", ",", "0"}], "]"}], "[", "r_", "]"}], "=", "0"}], ";"}], 
  " "}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Sigma]Coef\[Gamma]", "[", 
     RowBox[{"2", ",", "0"}], "]"}], "[", "r_", "]"}], "=", 
   FractionBox[
    RowBox[{
     SubscriptBox["g", 
      RowBox[{"t", ",", "t"}]], "[", "r", "]"}], "2"]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Sigma]Coef\[Gamma]", "[", 
     RowBox[{"0", ",", "2"}], "]"}], "[", "r_", "]"}], "=", 
   FractionBox[
    RowBox[{
     SubscriptBox["g", 
      RowBox[{"r", ",", "r"}]], "[", "r", "]"}], "2"]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"\[Sigma]Coef\[Gamma]", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"2", "i"}], "+", "1"}], ",", "_"}], "]"}], "[", "r_", "]"}], 
     "=", "0"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", 
      FractionBox["nMax", "2"]}], "}"}]}], "]"}], ";"}]}], "Input",
