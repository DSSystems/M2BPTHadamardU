Cell[TextData[{
 "Small coordinate expansion for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[InvisiblePrefixScriptBase]", "s"], 
    OverscriptBox["U", "_"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
